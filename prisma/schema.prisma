generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CREATOR
  MUSICIAN
}

enum JobStatus {
  PENDING_PAYMENT
  OPEN
  // Claimed for payout — Stripe in progress. Not a public state.
  AWARDING
  // Claimed for cancel/refund — Stripe in progress.
  CANCELLING
  AWARDED
  CANCELLED
}

model User {
  id              String   @id // matches the Supabase Auth user id (uuid)
  email           String   @unique
  name            String
  role            Role[]   // a person can be both a creator and a musician
  stripeAccountId String?  // Stripe Connect account, musicians only
  // Alt payouts (PayPal / Wise) when Stripe Connect transfers aren't available
  payoutCountry     String? // ISO 3166-1 alpha-2
  payoutProvider    String? // "stripe" | "paypal" | "wise"
  payoutEmail       String? // PayPal or Wise account email
  payoutAccountName String? // Name on the PayPal / Wise account
  createdAt       DateTime @default(now())

  // Email notification prefs (job alerts on by default; match profile instruments)
  notifyJobAlerts      Boolean  @default(true)
  notifyInstruments    String[] @default([]) // legacy; job alerts now use `instruments`
  notifyTakeSubmitted  Boolean  @default(true)
  notifyTakeOutcome    Boolean  @default(true)

  // Instruments this musician plays (catalog ids: piano, synth, keys, organ, …)
  instruments     String[] @default([])

  // Platform admin (dashboard at /admin). Also granted via ADMIN_EMAILS allowlist.
  isAdmin         Boolean  @default(false)

  jobsPosted      Job[]    @relation("JobsPosted")
  takesSubmitted  Take[]
}

model Job {
  id             String    @id @default(cuid())
  creator        User      @relation("JobsPosted", fields: [creatorId], references: [id])
  creatorId      String
  title          String
  instrument     String    // display label, e.g. "Synth"
  instrumentId   String?   // catalog id when posted via picker
  description    String
  demoFileUrl    String    // part being retracked (e.g. vocal demo only)
  backingFileUrl String?   // background without that part (e.g. instrumental)
  priceCents     Int
  // How long the musician will play (part length), not the bed/song file.
  durationSeconds Int?
  // Optional key for the part, e.g. "A minor" or "Bb major"
  musicalKey     String?
  // null = flexible/relative tempo; set = fixed BPM the take should match
  bpm            Int?
  deadline       DateTime
  // Set when we emailed matching musicians that this job has ~3 days left.
  threeDayReminderSentAt DateTime?
  // Set when we emailed the producer that the deadline hit and finalize grace started.
  finalizeReminderSentAt DateTime?
  status         JobStatus @default(OPEN)
  createdAt      DateTime  @default(now())
  // Set when award or cancel claims the row, so a crash can be retried after 30s.
  moneyClaimedAt DateTime?

  takes          Take[]
  payment        Payment?
}

model Take {
  id           String   @id @default(cuid())
  job          Job      @relation(fields: [jobId], references: [id])
  jobId        String
  musician     User     @relation(fields: [musicianId], references: [id])
  musicianId   String
  audioFileUrl String   // primary preview audio (first take); kept for backwards compat
  note         String?
  isWinner     Boolean  @default(false)
  submittedAt  DateTime @default(now())
  // Set when musician confirms the take is a real human performance (not AI)
  humanAttestedAt DateTime?

  files        TakeFile[]

  @@unique([jobId, musicianId])
}

enum TakeFileKind {
  AUDIO
  MIDI
}

model TakeFile {
  id         String       @id @default(cuid())
  take       Take         @relation(fields: [takeId], references: [id], onDelete: Cascade)
  takeId     String
  kind       TakeFileKind
  label      String
  fileUrl    String
  // Stream/scrub preview (usually MP3). Masters stay in fileUrl.
  previewUrl String?
  sortOrder  Int          @default(0)
  // Pairs MIDI with an audio take (0-based). Null = shared across all takes.
  audioIndex Int?

  @@index([takeId])
}

model Payment {
  id                      String   @id @default(cuid())
  job                     Job      @relation(fields: [jobId], references: [id])
  jobId                   String   @unique
  stripePaymentIntentId   String   @unique
  stripeCheckoutSessionId String?
  amountCents             Int
  platformFeeCents        Int
  status                  String   // "pending_checkout" | "authorized" | "captured" | "transferred" | "pending_manual_payout" | "cancelled" | "refunded" | "failed"
  createdAt               DateTime @default(now())
}

enum EmailBlastKind {
  TEST
  BLAST
}

// Admin-composed member emails (tests + full blasts).
model EmailBlast {
  id              String         @id @default(cuid())
  kind            EmailBlastKind
  subject         String
  bodyPlain       String
  bodyHtml        String
  ctaLabel        String?
  ctaHref         String?
  bottomImageUrl  String?
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  recipientEmails String[]       @default([])
  failuresJson    String?
  sentById        String?
  sentByName      String?
  createdAt       DateTime       @default(now())

  @@index([kind, createdAt])
  @@index([createdAt])
}
