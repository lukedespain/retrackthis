# Postgres via Supabase Transaction pooler (port 6543). Session mode (5432) exhausts
# the pool on Vercel serverless — use pgbouncer=true&connection_limit=1.
DATABASE_URL="postgresql://postgres.PROJECT:password@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase (auth + storage for demo/take audio files)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe (use test keys locally; live keys + matching webhook secret on Vercel for launch)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Public site URL (used for Stripe Connect return/refresh links)
NEXT_PUBLIC_APP_URL="https://retrackthis.com"

# Email (Resend) — new job alerts + take notifications
RESEND_API_KEY=""
RESEND_FROM="Retrack This <hello@retrackthis.com>"
RESEND_REPLY_TO="hello@retrackthis.com"
RESEND_WEBHOOK_SECRET=""
# Inbound: MX for hello@ is Google Workspace. Resend webhook is optional/legacy.
# Webhook URL (prod): https://retrackthis.com/api/webhooks/stripe
# Events: payment_intent.payment_failed, payment_intent.canceled,
#   payment_intent.amount_capturable_updated, payment_intent.succeeded, account.updated
